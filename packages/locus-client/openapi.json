  "components": {
    "schemas": {
      "AdmissionState": {
        "type": "string",
        "enum": [
          "open",
          "draining",
          "drained"
        ]
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "CopyProgress": {
        "type": "object",
        "required": [
          "file_id",
          "relative_path",
          "bytes_written",
          "managed_bytes_may_exist",
          "copy_complete"
        ],
        "properties": {
          "bytes_written": {
            "type": "string"
          },
          "copy_complete": {
            "type": "boolean"
          },
          "file_id": {
            "type": "string"
          },
          "managed_bytes_may_exist": {
            "type": "boolean"
          },
          "relative_path": {
            "type": "string"
          }
        }
      },
      "Diagnostic": {
        "type": "object",
        "required": [
          "kind",
          "message"
        ],
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/FailureKind"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "unauthorized",
          "foreign_origin",
          "wrong_run",
          "invalid_request",
          "request_conflict",
          "admission_closed",
          "launch_rejected",
          "unknown_request",
          "unknown_task",
          "missing_file",
          "operation_failed",
          "not_found",
          "method_not_allowed"
        ]
      },
      "FailureKind": {
        "type": "string",
        "enum": [
          "input_missing",
          "managed_bytes_missing",
          "access_denied",
          "not_regular_file",
          "io",
          "commit_outcome_unknown",
          "database",
          "domain",
          "executor"
        ]
      },
      "FileMetadata": {
        "type": "object",
        "required": [
          "file_id",
          "relative_path",
          "byte_count"
        ],
        "properties": {
          "byte_count": {
            "type": "string",
            "description": "Exact nonnegative decimal integer, never a JavaScript floating-point number."
          },
          "file_id": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          }
        }
      },
      "ImportOutcome": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "file",
              "status"
            ],
            "properties": {
              "file": {
                "$ref": "#/components/schemas/FileMetadata"
              },
              "status": {
                "type": "string",
                "enum": [
                  "imported"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "diagnostic",
              "status"
            ],
            "properties": {
              "diagnostic": {
                "$ref": "#/components/schemas/Diagnostic"
              },
              "progress": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CopyProgress"
                  }
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "failed"
                ]
              }
            }
          }
        ]
      },
      "ImportRequest": {
        "type": "object",
        "description": "An intentional import submission. Reuse its ID only with identical arguments.",
        "required": [
          "request_id",
          "source_path"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Canonical hyphenated UUID, scoped to the supplied backend run."
          },
          "source_path": {
            "type": "string",
            "description": "Absolute local source path. Copying preserves the source."
          }
        },
        "additionalProperties": false
      },
      "OutcomeResponse": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "pending"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "outcome",
              "status"
            ],
            "properties": {
              "outcome": {
                "$ref": "#/components/schemas/ImportOutcome"
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete"
                ]
              }
            }
          }
        ]
      },
      "PublicTask": {
        "type": "object",
        "required": [
          "task_id",
          "request_id",
          "label",
          "state",
          "outcome_available"
        ],
        "properties": {
          "completed": {
            "type": [
              "string",
              "null"
            ],
            "description": "Missing values mean unknown progress, not zero."
          },
          "label": {
            "type": "string"
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome_available": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          },
          "stage": {
            "type": [
              "string",
              "null"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/PublicTaskState"
          },
          "task_id": {
            "type": "string"
          },
          "total": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PublicTaskState": {
        "type": "string",
        "enum": [
          "submitted",
          "waiting",
          "running",
          "between_stages",
          "terminal"
        ]
      },
      "Receipt": {
        "type": "object",
        "required": [
          "run_id",
          "request_id",
          "task_id"
        ],
        "properties": {
          "request_id": {
            "type": "string"
          },
          "run_id": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          }
        }
      },
      "ServerStatus": {
        "type": "object",
        "required": [
          "run_id",
          "admission",
          "active_operations"
        ],
        "properties": {
          "active_operations": {
            "type": "string",
            "description": "Includes private direct-response work until actual queue completion."
          },
          "admission": {
            "$ref": "#/components/schemas/AdmissionState"
          },
          "run_id": {
            "type": "string"
          }
        }
      },
      "Submission": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "receipt",
              "status"
            ],
            "properties": {
              "receipt": {
                "$ref": "#/components/schemas/Receipt"
              },
              "status": {
                "type": "string",
                "enum": [
                  "accepted"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "error",
              "status"
            ],
            "properties": {
              "error": {
                "$ref": "#/components/schemas/ApiError"
              },
              "status": {
                "type": "string",
                "enum": [
                  "rejected"
                ]
              }
            }
          }
        ]
      },
      "TaskSnapshot": {
        "type": "object",
        "description": "Complete replacement projection. Reconnect replaces the prior baseline.",
        "required": [
          "run_id",
          "revision",
          "tasks"
        ],
        "properties": {
          "revision": {
            "type": "string",
            "description": "Exact monotonically increasing decimal revision within this run."
          },
          "run_id": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicTask"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
