{
  "name": "@locus/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "npm@12.0.2",
  "scripts": {
    "install:electron": "install-electron",
    "dev": "npm run build && electron-vite preview",
    "dev:renderer": "vite --host 127.0.0.1",
    "start": "electron-vite preview",
    "routes": "tsr generate",
    "typecheck": "npm run routes && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.verification.json",
    "test": "tsx --test tests/*.test.mjs",
    "build": "electron-vite build",
    "build:renderer": "vite build",
    "install:browser": "playwright install chromium",
    "preview:ui": "tsx scripts/browser-preview.ts",
    "preview:tasks": "tsx scripts/task-panel-preview.ts",
    "preview:notifications": "tsx scripts/task-panel-preview.ts --notifications",
    "verify:import-browser": "tsx scripts/import-browser-check.ts",
    "verify:import-native": "tsx scripts/import-electron-check.ts",
    "verify:shared-tasks": "tsx scripts/shared-task-browser-check.ts",
    "verify:notifications": "tsx scripts/notification-browser-check.ts",
    "verify:browser": "tsx scripts/browser-check.ts",
    "verify:electron": "tsx scripts/electron-smoke.ts && tsx scripts/electron-close-check.ts",
    "verify:model-browser": "tsx scripts/model-browser-check.ts",
    "verify:twitter-browser": "tsx scripts/twitter-browser-check.ts",
    "verify:twitter-native": "tsx scripts/twitter-electron-check.ts",
    "verify:video": "tsx scripts/video-electron-check.ts",
    "verify:scale": "tsx scripts/renderer-scale.ts",
    "verify:settings-workspace": "tsx scripts/settings-workspace-check.ts",
    "verify:settings-browser": "tsx scripts/settings-browser-check.ts",
    "verify:library-switch": "tsx scripts/library-switch-check.ts",
    "verify:settings-native": "tsx scripts/settings-electron-check.ts",
    "verify:civitai-browser": "tsx scripts/civitai-browser-check.ts",
    "verify:bilibili-browser": "tsx scripts/bilibili-browser-check.ts",
    "verify:bilibili-native": "tsx scripts/bilibili-electron-check.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/geist": "5.3.0",
    "@locus/client": "file:../../packages/locus-client",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "4.12.4",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.3",
    "electron-vite": "5.0.0",
    "playwright": "1.62.1",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
